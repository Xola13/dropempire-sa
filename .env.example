# =============================================
# DropEmpire SA — Environment Variables
# Copy to .env.local (dev) or set in your host's dashboard (prod).
# NEVER commit real values. .env* is git-ignored except this file.
# Generate secrets with:  openssl rand -base64 48
# =============================================

# --- Site (REQUIRED in production: used for PayFast callbacks and email links) ---
NEXT_PUBLIC_SITE_URL=https://dropempire.co.za

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Admin auth (REQUIRED) ---
# Admin login password. Min 16 chars; admin login is DISABLED if shorter/missing.
ADMIN_SECRET=change-me-to-a-strong-random-secret-min-32-chars
# Optional: separate key for signing admin session cookies (defaults to a key derived
# from ADMIN_SECRET). Set it to be able to rotate the password without logging out
# existing sessions, or to revoke all sessions by changing it.
ADMIN_SESSION_SECRET=

# --- Cron (REQUIRED) ---
# Vercel Cron automatically sends "Authorization: Bearer $CRON_SECRET". Min 16 chars.
CRON_SECRET=change-me-to-another-strong-random-secret

# --- Rate limiting (strongly recommended in production) ---
# Without these, limits are per serverless instance and easy to bypass.
# Free tier at https://upstash.com is plenty to start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Anthropic (Claude AI) ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Email (Resend) ---
RESEND_API_KEY=re_...
ADMIN_EMAIL=your@email.com
# Optional: full sender address. Defaults to orders@<your site hostname>.
FROM_EMAIL=orders@dropempire.co.za

# --- PayFast ---
# The values below are PayFast's public SANDBOX credentials. Replace for production.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
# "true" for sandbox testing, "false" (or unset) for production
NEXT_PUBLIC_PAYFAST_SANDBOX=true

# --- Yoco ---
YOCO_SECRET_KEY=sk_test_...
# Keep false until the Yoco card flow is built; hides the option and rejects it server-side.
NEXT_PUBLIC_YOCO_ENABLED=false

# --- Currency (update regularly or fetch from API) ---
NEXT_PUBLIC_EXCHANGE_RATE_USD_ZAR=18.5

# --- Bob Go Courier ---
BOBGO_API_KEY=your-bobgo-api-key

# --- Optional: AliExpress API ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# --- Optional: CJ Dropshipping API ---
CJ_EMAIL=
CJ_API_KEY=

# --- Marketplace Seller APIs ---
# Takealot Seller Portal: https://seller.takealot.com → Settings → API Keys
TAKEALOT_SELLER_API_KEY=
# Makro Seller Portal: https://seller.makro.co.za → API Settings
MAKRO_SELLER_API_KEY=

# --- Optional: where manual-order alerts go (defaults to ADMIN_EMAIL) ---
OWNER_EMAIL=

# --- Fulfilment ---
# "manual" (default): a paid order waits for you to click "Approve & order" in Admin -> Orders
# before any money is spent with suppliers. "auto": order from suppliers as soon as payment clears.
FULFILLMENT_MODE=manual

# --- Seller details (REQUIRED by SA law; shown on /contact, /terms and /privacy) ---
# Unset values show a visible "to be completed" notice on those pages.
SELLER_TRADING_NAME=DropEmpire SA
SELLER_LEGAL_NAME=
SELLER_REG_NUMBER=
SELLER_VAT_NUMBER=
SELLER_ADDRESS=
SELLER_EMAIL=
SELLER_PHONE=
SELLER_INFORMATION_OFFICER=

# --- AI cost control ---
# Hard cap on model calls per UTC day across all agents (default 300). Also set a monthly
# spend limit in the Anthropic console.
AI_DAILY_CALL_LIMIT=300
# Optional model override (default is set in lib/ai.ts)
ANTHROPIC_MODEL=

# --- Takealot/Makro browser auto-ordering ---
# Leave unset/false on Vercel: it cannot run a browser, and it logs into a personal retail
# account. Orders for these suppliers then come to you by email to place by hand.
PLAYWRIGHT_AUTO_ORDER=false
